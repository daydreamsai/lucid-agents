{
  "name": "@lucid-agents/mpp",
  "version": "3.0.0",
  "description": "Machine Payments Protocol (MPP) integration for Lucid Agents - multi-method payments via HTTP 402",
  "repository": {
    "type": "git",
    "url": "https://github.com/daydreamsai/lucid-agents",
    "directory": "packages/mpp"
  },
  "type": "module",
  "lucidAgents": {
    "runtime": "portable",
    "nodeExports": [
      "./storage/sqlite",
      "./storage/postgres"
    ]
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    },
    "./storage/sqlite": {
      "types": "./dist/storage/sqlite.d.ts",
      "import": "./dist/storage/sqlite.js",
      "default": "./dist/storage/sqlite.js"
    },
    "./storage/postgres": {
      "types": "./dist/storage/postgres.d.ts",
      "import": "./dist/storage/postgres.js",
      "default": "./dist/storage/postgres.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lucid-agents/types": "workspace:*",
    "mppx": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "pg": "^8.13.1",
    "viem": ">=2.54.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
